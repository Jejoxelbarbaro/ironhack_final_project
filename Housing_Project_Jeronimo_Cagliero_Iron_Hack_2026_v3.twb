      <table>
        <view>
          <datasources>
            <datasource caption='analysis_universe+' name='federated.0s1pyr70cmvyt3177q96k08xuhyk' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Value / Display As' datatype='string' name='[Parámetro 1691932136755221]' param-domain-type='list' role='measure' type='nominal' value='&quot;Monthly Income&quot;'>
              <calculation class='tableau' formula='&quot;Monthly Income&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s1pyr70cmvyt3177q96k08xuhyk'>
            <column caption='Age Mean' datatype='string' name='[AGE_MEAN]' role='dimension' type='nominal' />
            <column caption='Purchase Price per m²' datatype='real' name='[Calculation_1104516212547584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(REPLACE([price_m2_total], &quot;,&quot;, &quot;.&quot;))' />
            </column>
            <column caption='Total Purchase Price' datatype='real' name='[Calculation_1104516217602052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(REPLACE([price_total], &quot;,&quot;, &quot;.&quot;))' />
            </column>
            <column caption='Average Monthly Rent' datatype='real' name='[Calculation_1271643112042496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([rent_mean])' />
            </column>
            <column caption='Unemployement Rate' datatype='real' default-format='p0.00%' name='[Calculation_1691932119384064]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(FLOAT([PO_UNE]) / FLOAT([PO_ACTT]))' />
            </column>
            <column caption='Mean Age' datatype='real' name='[Calculation_1691932119760897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([AGE_MEAN])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1691932137701399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1691932136755221]&#13;&#10;&#13;&#10;    WHEN &quot;Mean Age&quot; THEN [Calculation_1691932119760897]&#13;&#10;&#13;&#10;    WHEN &quot;Monthly Income&quot; THEN [Calculation_2261753663254529]&#13;&#10;&#13;&#10;    WHEN &quot;PER&quot; THEN [Calculation_2261754016542724]&#13;&#10;&#13;&#10;    WHEN &quot;Population&quot; THEN [population]&#13;&#10;&#13;&#10;    WHEN &quot;Purchase Effort&quot; THEN [Calculation_2261754017566726]&#13;&#10;&#13;&#10;    WHEN &quot;Price x m²&quot; THEN [Calculation_1104516212547584]&#13;&#10;&#13;&#10;    WHEN &quot;Rental Effort&quot; THEN [Calculation_2261754016763909]&#13;&#10;&#13;&#10;    WHEN &quot;Average Monthly Rent&quot; THEN [Calculation_1271643112042496]&#13;&#10;&#13;&#10;    WHEN &quot;Total Price&quot; THEN [Calculation_1104516217602052]&#13;&#10;&#13;&#10;    WHEN &quot;Unemployment Rate&quot; THEN [Calculation_1691932119384064]&#13;&#10;&#13;&#10;END' />
