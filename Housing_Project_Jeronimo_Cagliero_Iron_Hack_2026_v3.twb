            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>POPULATION GROWTH (2013 - &lt;</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>[Parameters].[Parámetro 1691932748898341]</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book' fontsize='9'>&gt;)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analysis_universe+' name='federated.0s1pyr70cmvyt3177q96k08xuhyk' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Comparison Year' datatype='real' name='[Parámetro 1691932748898341]' param-domain-type='list' role='measure' type='quantitative' value='2023.0'>
              <calculation class='tableau' formula='2023.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s1pyr70cmvyt3177q96k08xuhyk'>
            <column caption='Population 2013' datatype='integer' name='[Calculation_1691932749439014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [population]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Population Comparison Year' datatype='integer' name='[Calculation_1691932749582375]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = [Parameters].[Parámetro 1691932748898341]&#13;&#10;        THEN [population]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Avg Population Growth' datatype='real' name='[Calculation_1691932749803560]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parámetro 1691932748898341] &gt; 2013&#13;&#10;AND [Calculation_1691932749439014] &gt; 0&#13;&#10;AND NOT ISNULL([Calculation_1691932749582375])&#13;&#10;THEN&#13;&#10;    (&#13;&#10;        [Calculation_1691932749582375] / [Calculation_1691932749439014]&#13;&#10;    ) ^ (1.0 / ([Parameters].[Parámetro 1691932748898341] - 2013)) - 1&#13;&#10;END' />
            </column>
            <column datatype='string' name='[municipality]' role='dimension' type='nominal' />
            <column-instance column='[municipality]' derivation='None' name='[none:municipality:nk]' pivot='key' type='nominal' />
            <column-instance column='[year (PER_municipal.csv)]' derivation='None' name='[none:year (PER_municipal.csv):qk]' pivot='key' type='quantitative' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Population' datatype='integer' name='[population]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1691932749803560]' derivation='Sum' name='[sum:Calculation_1691932749803560:qk]' pivot='key' type='quantitative' />
            <column caption='year (PER municipal.csv)' datatype='integer' name='[year (PER_municipal.csv)]' role='dimension' type='quantitative' />
            <column datatype='integer' name='[year]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0s1pyr70cmvyt3177q96k08xuhyk].[none:municipality:nk]' filter-group='6'>
            <groupfilter function='member' level='[none:municipality:nk]' member='&quot;Montcada i Reixac&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
