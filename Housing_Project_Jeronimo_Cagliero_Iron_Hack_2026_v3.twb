                <zone forceUpdate='true' h='12500' id='28' type-v2='text' w='32724' x='66398' y='12891'>
                  <formatted-text>
                    <run>AVG Municipality Growth (2013 - 2023):
</run>
                    <run fontsize='20'>7,6 %</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#e15759' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='5' />
