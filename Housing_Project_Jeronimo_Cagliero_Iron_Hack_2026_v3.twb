                    <format attr='background-color' value='#faf5f4' />
                  </zone-style>
                </zone>
                <zone fixed-size='894' forceUpdate='true' h='20443' id='22' type-v2='text' w='66033' x='586' y='25911'>
                  <formatted-text>
                    <run bold='true' fontalignment='0' fontcolor='#e15759' fontname='Nunito Black' fontsize='12'>2. Buying a home is becoming harder</run>
                    <run fontalignment='0'>Æ&#10;</run>
                    <run fontalignment='0' fontname='Benton Sans Book'>Housing prices increased by an average of </run>
                    <run bold='true' fontalignment='0' fontname='Benton Sans Book'>4.22% per year</run>
                    <run fontalignment='0' fontname='Benton Sans Book'> between 2013 and 2023, while mortgage interest rates also rose. Changes in the number of property transactions show how the housing market evolved during this period.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='20443' id='41' type-v2='text' w='32795' x='66619' y='25911'>
                  <formatted-text>
                    <run>AVG sq mt&#10; Yearly Growth&#10;</run>
                    <run fontsize='20'>4,22 % ↑</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#e15759' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='2' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='5' />
