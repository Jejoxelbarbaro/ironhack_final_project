        <calculation class='tableau' formula='(FLOAT([PO_UNE]) / FLOAT([PO_ACTT]))' />
      </column>
      <column caption='Mean Age' datatype='real' name='[Calculation_1691932119760897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([AGE_MEAN])' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_1691932137701399]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1691932136755221]&#13;&#10;&#13;&#10;    WHEN &quot;Mean Age&quot; THEN [Calculation_1691932119760897]&#13;&#10;&#13;&#10;    WHEN &quot;Monthly Income&quot; THEN [Calculation_2261753663254529]&#13;&#10;&#13;&#10;    WHEN &quot;PER&quot; THEN [Calculation_2261754016542724]&#13;&#10;&#13;&#10;    WHEN &quot;Population&quot; THEN [population]&#13;&#10;&#13;&#10;    WHEN &quot;Purchase Effort&quot; THEN [Calculation_2261754017566726]&#13;&#10;&#13;&#10;    WHEN &quot;Price x m²&quot; THEN [Calculation_1104516212547584]&#13;&#10;&#13;&#10;    WHEN &quot;Rental Effort&quot; THEN [Calculation_2261754016763909]&#13;&#10;&#13;&#10;    WHEN &quot;Average Monthly Rent&quot; THEN [Calculation_1271643112042496]&#13;&#10;&#13;&#10;    WHEN &quot;Total Price&quot; THEN [Calculation_1104516217602052]&#13;&#10;&#13;&#10;    WHEN &quot;Unemployment Rate&quot; THEN [Calculation_1691932119384064]&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Category Metric' datatype='string' name='[Calculation_1691932699934753]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1691932699078688]&#13;&#10;&#13;&#10;WHEN &quot;Sale&quot; THEN&#13;&#10;    &quot;Sale&quot;&#13;&#10;&#13;&#10;WHEN &quot;Rent&quot; THEN&#13;&#10;    &quot;Rent&quot;&#13;&#10;&#13;&#10;WHEN &quot;Mortgage&quot; THEN&#13;&#10;    &quot;Mortgage&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Average Housing Effort' datatype='real' name='[Calculation_1691932745797667]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    [Calculation_2261754016763909] * 0.5&#13;&#10;    + [Calculation_2261754017566726] * 0.30&#13;&#10;    + [effort_mortgage_general_pct] * 0.20&#13;&#10;)' />
      </column>
      <column caption='Population 2013' datatype='integer' name='[Calculation_1691932749439014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [population]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Population Comparison Year' datatype='integer' name='[Calculation_1691932749582375]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = [Parameters].[Parámetro 1691932748898341]&#13;&#10;        THEN [population]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Avg Population Growth' datatype='real' name='[Calculation_1691932749803560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parámetro 1691932748898341] &gt; 2013&#13;&#10;AND [Calculation_1691932749439014] &gt; 0&#13;&#10;AND NOT ISNULL([Calculation_1691932749582375])&#13;&#10;THEN&#13;&#10;    (&#13;&#10;        [Calculation_1691932749582375] / [Calculation_1691932749439014]&#13;&#10;    ) ^ (1.0 / ([Parameters].[Parámetro 1691932748898341] - 2013)) - 1&#13;&#10;END' />
      </column>
      <column caption='Barcelona Label' datatype='string' name='[Calculation_1691932755152937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [municipality] = &quot;Barcelona&quot; THEN&#13;&#10;    [municipality]&#13;&#10;END' />
      </column>
      <column caption='Purchase Price 2013' datatype='real' name='[Calculation_1691932761239594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Purchase Price 2023' datatype='real' name='[Calculation_1691932761440299]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2023&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Purchase Price Change %' datatype='real' name='[Calculation_1691932761571372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1691932761440299] / [Calculation_1691932761239594]  - 1&#13;&#10;) / 10' />
      </column>
      <column caption='Monthly Income per Capita' datatype='real' name='[Calculation_2261753663254529]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([income_per_capita_eur])/12' />
      </column>
      <column caption='Barcelona Highlight' datatype='string' name='[Calculation_2261753988898818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [municipality] = &quot;Barcelona&quot; THEN&#13;&#10;    &quot;Barcelona&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Resto&quot;&#13;&#10;END' />
      </column>
      <column caption='PER_municipal_nmbr' datatype='real' name='[Calculation_2261753991045123]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([PER])' />
      </column>
      <column caption='PER (Mun)' datatype='real' name='[Calculation_2261754016542724]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([PER (metricas_municipales_completo.csv)])' />
      </column>
      <column caption='Rental Effort' datatype='real' name='[Calculation_2261754016763909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([effort_rent_pct])' />
      </column>
      <column caption='Purchase Effort (Mun)' datatype='real' name='[Calculation_2261754017566726]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([effort_purchase_pct])' />
      </column>
      <column caption='Rent 2013' datatype='real' name='[Calculation_2422833424715778]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2013 THEN [Calculation_1271643112042496] END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Annual Average Growth Rent %' datatype='real' name='[Calculation_2422833425227780]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2422833424715778] != 0 THEN&#13;&#10;    (([Rent 2013 (copia)_2422833425149955] / [Calculation_2422833424715778]) - 1) / 10&#13;&#10;END' />
      </column>
      <column caption='Mortgage 2013' datatype='real' name='[Calculation_2422833425973254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [estimated_monthly_mortgage_payment_eur]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Annual Average Growth Mortgage %' datatype='real' name='[Calculation_2422833426223112]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2422833425973254] != 0 THEN&#13;&#10;    (([Mortgage 2013 (copia)_2422833426137095] /&#13;&#10;      [Calculation_2422833425973254]) - 1) / 10&#13;&#10;END' />
      </column>
      <column caption='Mortgage 2023' datatype='real' name='[Mortgage 2013 (copia)_2422833426137095]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2023&#13;&#10;        THEN [estimated_monthly_mortgage_payment_eur]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
