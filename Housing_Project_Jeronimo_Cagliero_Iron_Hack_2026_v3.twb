      <table>
        <view>
          <datasources>
            <datasource caption='analysis_universe+' name='federated.0s1pyr70cmvyt3177q96k08xuhyk' />
          </datasources>
          <datasource-dependencies datasource='federated.0s1pyr70cmvyt3177q96k08xuhyk'>
            <column caption='Monthly income 2023' datatype='real' name='[Calculation_0590498815471616]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    AVG(&#13;&#10;        IF [year] = 2023 THEN [Calculation_2261753663254529] END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Annual Average Growth Income %' datatype='real' name='[Calculation_0590498818338818]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    (&#13;&#10;        MAX([Calculation_0590498815471616]) /&#13;&#10;        MAX([Monthly income 2023 (copia)_0590498818215937])&#13;&#10;    ) ^ (1.0 / 10) - 1&#13;&#10;}' />
