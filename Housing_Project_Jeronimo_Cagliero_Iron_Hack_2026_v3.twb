    <worksheet name='Barchart'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Metric</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='analysis_universe+' name='federated.0s1pyr70cmvyt3177q96k08xuhyk' />
            <datasource caption='Parámetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Value / Display As' datatype='string' name='[Parámetro 1691932136755221]' param-domain-type='list' role='measure' type='nominal' value='&quot;Rental Effort&quot;'>
              <calculation class='tableau' formula='&quot;Rental Effort&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0s1pyr70cmvyt3177q96k08xuhyk'>
            <column caption='Purchase Price per m²' datatype='real' default-format='C3082%' name='[Calculation_1104516212547584]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(REPLACE([price_m2_total], &quot;,&quot;, &quot;.&quot;))' />
            </column>
            <column caption='Total Purchase Price' datatype='real' name='[Calculation_1104516217602052]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(REPLACE([price_total], &quot;,&quot;, &quot;.&quot;))' />
            </column>
            <column caption='Average Monthly Rent' datatype='real' default-format='C3082%' name='[Calculation_1271643112042496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([rent_mean])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1691932137701399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1691932136755221]&#13;&#10;&#13;&#10;    WHEN &quot;Monthly Income&quot; THEN [Calculation_2261753663254529]&#13;&#10;&#13;&#10;    WHEN &quot;PER&quot; THEN [Calculation_2261754016542724]&#13;&#10;&#13;&#10;    WHEN &quot;Population&quot; THEN [population]&#13;&#10;&#13;&#10;    WHEN &quot;Purchase Effort&quot; THEN [Calculation_2261754017566726]&#13;&#10;&#13;&#10;    WHEN &quot;Price x m²&quot; THEN [Calculation_1104516212547584]&#13;&#10;&#13;&#10;    WHEN &quot;Rental Effort&quot; THEN [Calculation_2261754016763909]&#13;&#10;&#13;&#10;    WHEN &quot;Total Price&quot; THEN [Calculation_1104516217602052]&#13;&#10;&#13;&#10;    WHEN &quot;Rent avg price&quot; THEN [Calculation_1271643112042496]&#13;&#10;&#13;&#10;    WHEN &quot;Price Change&quot; THEN [Calculation_1691932761571372]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Purchase Price 2013' datatype='real' name='[Calculation_1691932761239594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Purchase Price 2023' datatype='real' name='[Calculation_1691932761440299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2023&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Annual Average Growth Purchase %' datatype='real' default-format='p0.00%' name='[Calculation_1691932761571372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;(&#13;&#10;    [Calculation_1691932761440299] / [Calculation_1691932761239594]  - 1&#13;&#10;) / 10)&#13;&#10;&#13;&#10;}' />
            </column>
            <column caption='Monthly Income per Capita' datatype='real' default-format='C3082%' name='[Calculation_2261753663254529]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality], [year] :&#13;&#10;    AVG(FLOAT([income_per_capita_eur]) / 12)&#13;&#10;}' />
            </column>
            <column caption='PER (Mun)' datatype='real' name='[Calculation_2261754016542724]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([PER (metricas_municipales_completo.csv)])' />
            </column>
            <column caption='Rental Effort' datatype='real' default-format='p0.00%' name='[Calculation_2261754016763909]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([effort_rent_pct])/100' />
            </column>
            <column caption='Purchase Effort (Mun)' datatype='real' default-format='p0.00%' name='[Calculation_2261754017566726]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([effort_purchase_pct])/100' />
            </column>
            <column caption='PER (metricas municipales completo.csv)' datatype='string' name='[PER (metricas_municipales_completo.csv)]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1691932137701399]' derivation='Avg' name='[avg:Calculation_1691932137701399:qk]' pivot='key' type='quantitative' />
            <column caption='Effort Purchase Pct' datatype='string' name='[effort_purchase_pct]' role='dimension' type='nominal' />
            <column caption='Effort Rent Pct' datatype='string' name='[effort_rent_pct]' role='dimension' type='nominal' />
            <column caption='Income Per Capita Eur' datatype='string' name='[income_per_capita_eur]' role='dimension' type='nominal' />
            <column datatype='string' name='[municipality]' role='dimension' type='nominal' />
            <column-instance column='[municipality]' derivation='None' name='[none:municipality:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Population' datatype='integer' name='[population]' role='measure' type='quantitative' />
            <column caption='Price M2 Total' datatype='string' default-role='measure' default-type='ordinal' name='[price_m2_total]' role='dimension' type='nominal' />
            <column caption='Price Total' datatype='string' default-role='measure' default-type='ordinal' name='[price_total]' role='dimension' type='nominal' />
            <column caption='Rent Mean' datatype='string' default-role='measure' default-type='ordinal' name='[rent_mean]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1691932137701399]' derivation='Sum' name='[sum:Calculation_1691932137701399:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[year]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0s1pyr70cmvyt3177q96k08xuhyk].[avg:Calculation_1691932137701399:qk]' included-values='in-range' />
