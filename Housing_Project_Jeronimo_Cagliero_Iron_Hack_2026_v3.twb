            </column>
            <column caption='Average Monthly Rent' datatype='real' default-format='C3082%' name='[Calculation_1271643112042496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT([rent_mean])' />
            </column>
            <column caption='Selected Metric' datatype='real' name='[Calculation_1691932137701399]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parámetro 1691932136755221]&#13;&#10;&#13;&#10;    WHEN &quot;Monthly Income&quot; THEN [Calculation_2261753663254529]&#13;&#10;&#13;&#10;    WHEN &quot;PER&quot; THEN [Calculation_2261754016542724]&#13;&#10;&#13;&#10;    WHEN &quot;Population&quot; THEN [population]&#13;&#10;&#13;&#10;    WHEN &quot;Purchase Effort&quot; THEN [Calculation_2261754017566726]&#13;&#10;&#13;&#10;    WHEN &quot;Price x m²&quot; THEN [Calculation_1104516212547584]&#13;&#10;&#13;&#10;    WHEN &quot;Rental Effort&quot; THEN [Calculation_2261754016763909]&#13;&#10;&#13;&#10;    WHEN &quot;Total Price&quot; THEN [Calculation_1104516217602052]&#13;&#10;&#13;&#10;    WHEN &quot;Rent avg price&quot; THEN [Calculation_1271643112042496]&#13;&#10;&#13;&#10;    WHEN &quot;Price Change&quot; THEN [Calculation_1691932761571372]&#13;&#10;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Purchase Price 2013' datatype='real' name='[Calculation_1691932761239594]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2013&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Purchase Price 2023' datatype='real' name='[Calculation_1691932761440299]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;        IF [year] = 2023&#13;&#10;        THEN [Calculation_1104516212547584]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Annual Average Growth Purchase %' datatype='real' default-format='p0.00%' name='[Calculation_1691932761571372]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [municipality] :&#13;&#10;    MAX(&#13;&#10;(&#13;&#10;    [Calculation_1691932761440299] / [Calculation_1691932761239594]  - 1&#13;&#10;) / 10)&#13;&#10;&#13;&#10;}' />
            </column>
            <column caption='Monthly Income per Capita' datatype='real' default-format='C3082%' name='[Calculation_2261753663254529]' role='measure' type='quantitative'>
